# Copy this file to .env and fill in real values. Never commit .env.
#
# All 4 of these are needed to deploy demo/server.py (Render today, Railway
# next) - SARVAM_API_KEY, ANTHROPIC_API_KEY, GOOGLE_SERVICE_ACCOUNT_JSON,
# GOOGLE_SHEET_ID. The WhatsApp entrypoint (src/webhook.py) explored early
# on is retired to draft/ and not part of this app - no WhatsApp vars needed.

# Sarvam AI (Speech-to-Text, Hindi/Avadhi)
SARVAM_API_KEY=

# Anthropic (LLM — Practice persona/scoring, Mera Madad coach)
ANTHROPIC_API_KEY=

# Google Sheets logging
# Locally: a file path (service_account.json, gitignored).
# On a cloud host with no persistent file (e.g. Render): paste the key
# file's whole JSON content as this variable's value instead - both are
# auto-detected by src/sheets_logger.py.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=

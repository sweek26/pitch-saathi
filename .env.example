# Copy this file to .env and fill in real values. Never commit .env.
#
# Only 4 of these are needed to deploy demo/server.py (Render today, Railway
# next) - SARVAM_API_KEY, ANTHROPIC_API_KEY, GOOGLE_SERVICE_ACCOUNT_JSON,
# GOOGLE_SHEET_ID. The WHATSAPP_* block below is for src/webhook.py, the
# real WhatsApp entrypoint - moved to draft/ in the pre-Railway cleanup
# (not connected yet), so skip it when setting up Railway env vars.

# WhatsApp Cloud API (Meta for Developers) - draft/whatsapp-entrypoint/ only
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Sarvam AI (Speech-to-Text, Hindi/Avadhi)
SARVAM_API_KEY=

# Anthropic (LLM — Practice persona/scoring, Mera Madad coach)
ANTHROPIC_API_KEY=

# Google Sheets logging
# Locally: a file path (service_account.json, gitignored).
# On a cloud host with no persistent file (e.g. Render): paste the key
# file's whole JSON content as this variable's value instead - both are
# auto-detected by src/sheets_logger.py.
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=
